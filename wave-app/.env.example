# Copy this file to `.env` and fill in the values from
# Supabase Dashboard → Project Settings → API Keys.

# ---- Used by the app (safe to ship in the client bundle) --------------------
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "publishable" key (sb_publishable_...). A legacy "anon" key also works.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Server-side only. NEVER prefix with EXPO_PUBLIC_ ------------------------
# The "secret" key (sb_secret_...) bypasses Row Level Security. The app does
# not use it; it's here for the Supabase CLI / admin scripts you might add.
SUPABASE_SECRET_KEY=
